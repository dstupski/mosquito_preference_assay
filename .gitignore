# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/

# colcon / ament build artifacts (this package is cloned into a workspace's src/)
build/
install/
log/

# Per-rig config: copy config/<name>.yaml to config/<name>.local.yaml and edit
# that. The launch files prefer a .local.yaml when one exists, so a pull can
# never modify the config you are actually running on.
config/*.local.yaml

# Rig alignment written by display_check. These describe THIS machine's
# projector on a given day, so they are never ours to track -- and ignoring
# them also means `git clean -fd` will not sweep them away.
*_display_config.yaml
display_alignment.yaml

# rosbags
*.db3
*.mcap
rosbag2_*/
mpa_*/

# editors / OS
.idea/
.vscode/
*.swp
*~
.DS_Store
